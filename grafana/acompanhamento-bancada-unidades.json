          "rawQuery": true,
          "rawSql": "SELECT COALESCE(NULLIF(TRIM(unidade_setor),''),'(sem unidade)') AS 'Unidade',\n  SUM(tipo_equipamento IN ('Nobreak','Nobrak')) AS 'Nobreak',\n  SUM(tipo_equipamento='Computador') AS 'Computador',\n  SUM(tipo_equipamento='Notebook') AS 'Notebook',\n  SUM(tipo_equipamento='Monitor') AS 'Monitor',\n  SUM(tipo_equipamento NOT IN ('Nobreak','Nobrak','Computador','Notebook','Monitor')) AS 'Outros',\n  COUNT(*) AS 'Total'\nFROM bancada_equipments\nWHERE status IN ('Pronto para entrega','Nota Fiscal Emitida')\nGROUP BY 1\nORDER BY Total DESC, Unidade",
