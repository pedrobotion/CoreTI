      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(NULLIF(TRIM(unidade_setor),''),'(sem unidade)') AS 'Unidade',\n  NULLIF(SUM(tipo_equipamento IN ('Nobreak','Nobrak')),0) AS 'Nobreak',\n  NULLIF(SUM(tipo_equipamento='Computador'),0) AS 'Computador',\n  NULLIF(SUM(tipo_equipamento='Notebook'),0) AS 'Notebook',\n  NULLIF(SUM(tipo_equipamento='Monitor'),0) AS 'Monitor',\n  NULLIF(SUM(tipo_equipamento NOT IN ('Nobreak','Nobrak','Computador','Notebook','Monitor')),0) AS 'Outros'\nFROM bancada_equipments\nWHERE status IN ('Pronto para entrega','Nota Fiscal Emitida')\nGROUP BY 1\nORDER BY COUNT(*) DESC, Unidade\nLIMIT 18",
          "refId": "A"
        }
      ],
      "title": "Top unidades a entregar (por tipo)",
      "type": "barchart"
