          "rawQuery": true,
          "rawSql": "SELECT COALESCE(NULLIF(plaqueta,''), NULLIF(tic,''), CONCAT('#',id)) AS 'Plaqueta', tipo_equipamento AS 'Tipo', COALESCE(NULLIF(TRIM(unidade_setor),''),'—') AS 'Unidade', status AS 'Status', DATE_FORMAT(data_chegada,'%d/%m/%Y') AS 'Chegada', DATEDIFF(CURDATE(),data_chegada) AS 'Dias' FROM bancada_equipments WHERE status NOT IN ('Entregue','Descarte','Backup') AND data_chegada IS NOT NULL ORDER BY data_chegada ASC LIMIT 15",
