        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CONCAT(de,' → ',para) AS 'Transição', ROUND(AVG(mins)/1440,1) AS 'Dias' FROM (SELECT status de, LEAD(status) OVER (PARTITION BY bancada_equipment_id ORDER BY start_time) para, TIMESTAMPDIFF(MINUTE,start_time,end_time) mins FROM bancada_equipment_status_histories WHERE end_time IS NOT NULL AND end_time >= start_time) x WHERE para IS NOT NULL GROUP BY de,para HAVING COUNT(*) >= 3 ORDER BY 2 DESC LIMIT 12",
          "refId": "A"
        }
      ],
      "title": "SLA médio de transição entre status (dias)",
