                    "rawQuery": true,
                    "editorMode": "code",
                    "rawSql": "SELECT COALESCE(ou.name, 'Sem unidade informada') AS 'Unidade', COUNT(*) AS 'Linhas', ROUND(SUM(cl.valor_mensal), 2) AS 'Custo' FROM corp_lines cl JOIN (SELECT ai.corp_line_id, MAX(aa.id) AS assignment_id FROM asset_assignment_items ai JOIN asset_assignments aa ON aa.id = ai.asset_assignment_id AND aa.ativo = 1 WHERE ai.corp_line_id IS NOT NULL GROUP BY ai.corp_line_id) v ON v.corp_line_id = cl.id JOIN asset_assignments aa ON aa.id = v.assignment_id JOIN hr_collaborators hc ON hc.id = aa.hr_collaborator_id LEFT JOIN organization_units ou ON ou.source_id = hc.unit_source_id WHERE cl.status <> 'Cancelada' GROUP BY ou.name ORDER BY 3 DESC LIMIT 15"
