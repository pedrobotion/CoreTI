            "targets": [
                {
                    "refId": "A",
                    "format": "table",
                    "rawQuery": true,
                    "editorMode": "code",
                    "rawSql": "SELECT * FROM (\nSELECT COALESCE(NULLIF(e.plaqueta,''),NULLIF(e.tic,''),CONCAT('#',e.id)) AS 'Equip.',\n      e.tipo_equipamento AS 'Tipo', COALESCE(NULLIF(TRIM(e.unidade_setor),''),'—') AS 'Unidade',\n      'Entrada fiscal' AS 'Pendência', TIMESTAMPDIFF(DAY,h.start_time,NOW()) AS 'Dias'\n      FROM bancada_equipments e JOIN bancada_equipment_status_histories h ON h.bancada_equipment_id=e.id AND h.end_time IS NULL WHERE e.status IN ('Aguardando Entrada Fiscal','Aguardando Entrada') AND TIMESTAMPDIFF(DAY,h.start_time,NOW())>5\n      UNION ALL\nSELECT COALESCE(NULLIF(e.plaqueta,''),NULLIF(e.tic,''),CONCAT('#',e.id)) AS 'Equip.',\n      e.tipo_equipamento AS 'Tipo', COALESCE(NULLIF(TRIM(e.unidade_setor),''),'—') AS 'Unidade',\n      'Saída NF' AS 'Pendência', TIMESTAMPDIFF(DAY,h.start_time,NOW()) AS 'Dias'\n      FROM bancada_equipments e JOIN bancada_equipment_status_histories h ON h.bancada_equipment_id=e.id AND h.end_time IS NULL WHERE e.status='Pronto para entrega' AND e.nota_saida_emitida_em IS NULL AND TIMESTAMPDIFF(DAY,h.start_time,NOW())>1\n      UNION ALL\nSELECT COALESCE(NULLIF(e.plaqueta,''),NULLIF(e.tic,''),CONCAT('#',e.id)) AS 'Equip.',\n      e.tipo_equipamento AS 'Tipo', COALESCE(NULLIF(TRIM(e.unidade_setor),''),'—') AS 'Unidade',\n      'Terceiros' AS 'Pendência', TIMESTAMPDIFF(DAY,h.start_time,NOW()) AS 'Dias'\n      FROM bancada_equipments e JOIN bancada_equipment_status_histories h ON h.bancada_equipment_id=e.id AND h.end_time IS NULL WHERE e.status='Terceiros' AND TIMESTAMPDIFF(DAY,h.start_time,NOW())>15\n      UNION ALL\nSELECT COALESCE(NULLIF(e.plaqueta,''),NULLIF(e.tic,''),CONCAT('#',e.id)) AS 'Equip.',\n      e.tipo_equipamento AS 'Tipo', COALESCE(NULLIF(TRIM(e.unidade_setor),''),'—') AS 'Unidade',\n      'Aguardando peça' AS 'Pendência', TIMESTAMPDIFF(DAY,h.start_time,NOW()) AS 'Dias'\n      FROM bancada_equipments e JOIN bancada_equipment_status_histories h ON h.bancada_equipment_id=e.id AND h.end_time IS NULL WHERE e.status='Aguardando peça' AND TIMESTAMPDIFF(DAY,h.start_time,NOW())>10\n) x ORDER BY Dias DESC LIMIT 40"
                }
