            "title": "Impressões no mês (páginas)",
            "datasource": {
                "type": "mysql",
                "uid": "${ds}"
            },
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 0,
                "y": 1
            },
            "fieldConfig": {
                "defaults": {},
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "/^valor$/"
                },
                "textMode": "value",
                "colorMode": "none",
                "graphMode": "none",
                "justifyMode": "center",
                "wideLayout": true
            },
            "targets": [
                {
                    "refId": "A",
                    "format": "table",
                    "rawQuery": true,
                    "editorMode": "code",
                    "rawSql": "SELECT FORMAT(COALESCE(SUM(paginas),0),0,'de_DE') AS valor FROM print_jobs WHERE $__timeFilter(impresso_em - INTERVAL 3 HOUR)"
                }
            ]
