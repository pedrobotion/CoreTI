                    "editorMode": "code",
                    "rawSql": "SELECT CONCAT('R$ ', FORMAT((SELECT COALESCE(SUM(GREATEST(dm,0))*0.0316+SUM(GREATEST(dc,0))*0.3165,0) FROM (SELECT MAX(mono_pages)-MIN(mono_pages) AS dm, MAX(colour_pages)-MIN(colour_pages) AS dc FROM printer_meters WHERE MONTH(billing_date)=MONTH(NOW()) AND YEAR(billing_date)=YEAR(NOW()) GROUP BY printer_id) x) + (SELECT COALESCE(SUM(rental_value),0) FROM printers),2,'de_DE')) AS valor"
                }
            ],
