APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Fuso usado apenas para EXIBIR datas, via macro ->local(). O armazenamento
# continua em UTC, que nao tem horario de verao nem ambiguidade.
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

JIRA_AUTOMATION_WEBHOOK_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# 'daily' rotaciona por dia e poda automaticamente; 'single' cresce sem limite.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Dias de logs diarios mantidos. Em producao use LOG_LEVEL=info ou superior.
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

INTRANET_COCARI_DB_HOST=127.0.0.1
INTRANET_COCARI_DB_PORT=3306
INTRANET_COCARI_DB_DATABASE=intranet_cocari
INTRANET_COCARI_DB_USERNAME=
INTRANET_COCARI_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Notificacoes automaticas de sincronizacoes CoreTI.
# Separe varios destinatarios por virgula. Por padrao usa MAIL_FROM_ADDRESS.
CORETI_SYNC_NOTIFICATIONS_ENABLED=true
CORETI_SYNC_NOTIFICATION_RECIPIENTS=""

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

JIRA_TICKET_BASE_URL=
JIRA_BANCADA_TICKET_BASE_URL=

GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_ADMIN_SUBJECT=
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_WORKSPACE_EMAIL_TOTAL_LICENSES=

# Modulo de Admissao.
# Projetos Jira por area; em branco usa JIRA_PROJECT_KEY.
ADMISSAO_JIRA_PROJECT_TI=
ADMISSAO_JIRA_PROJECT_PATRIMONIO=
ADMISSAO_JIRA_PROJECT_RH=
ADMISSAO_JIRA_PROJECT_SEGURANCA=
# true = um chamado por area (recomendado); false = um chamado por tarefa.
ADMISSAO_CHAMADO_POR_AREA=true

# Permissoes de modulo: enquanto true, role=admin ignora as concessoes
# explicitas. Desligue apos conferir a tela de administracao.
MODULES_LEGACY_ADMIN_BYPASS=true

# Auditoria de backups de banco (substitui o fluxo do n8n).
# Token exigido no header X-Coreti-Token pelos agentes nos servidores.
BACKUP_WEBHOOK_TOKEN=
# Opcional: restringe a origem. IPs ou faixas CIDR separados por virgula.
BACKUP_WEBHOOK_ALLOWED_IPS=
# Horas sem reportar antes de considerar o par host/banco em silencio.
BACKUP_STALE_AFTER_HOURS=36
BACKUP_STALE_CHECK_TIME=08:00
# Minutos de silencio antes de abrir novo chamado do mesmo host/banco.
BACKUP_JIRA_COOLDOWN_MINUTES=360
# Mapeamento do chamado (valores atuais do fluxo n8n).
BACKUP_JIRA_ENABLED=true
BACKUP_JIRA_PROJECT_ID=10005
BACKUP_JIRA_ISSUE_TYPE_ID=10008
BACKUP_JIRA_SERVICE_DESK_ID=5
BACKUP_JIRA_REQUEST_TYPE_ID=713
BACKUP_JIRA_TEAM_FIELD=customfield_10087
BACKUP_JIRA_REQUEST_TYPE_FIELD=customfield_10010
BACKUP_JIRA_TEAM_FIELD_CONTEXT=10192
# Prefira o nome da opcao; o indice so e usado se o nome nao for encontrado.
BACKUP_JIRA_TEAM_OPTION_NAME=
BACKUP_JIRA_TEAM_OPTION_INDEX=5
# Importacao do historico legado (opcional).
BACKUP_LEGACY_CONNECTION=auditoria_backups
BACKUP_LEGACY_TABLE=backup_auditoria
# Credenciais da base legada de auditoria (so para backups:importar-legado).
AUDITORIA_BACKUPS_DB_HOST=172.17.3.97
AUDITORIA_BACKUPS_DB_PORT=3306
AUDITORIA_BACKUPS_DB_DATABASE=auditoria_backups
AUDITORIA_BACKUPS_DB_USERNAME=
AUDITORIA_BACKUPS_DB_PASSWORD=

# Verificacao ativa de backup por SSH (o CoreTI confere o arquivo no servidor).
BACKUP_SSH_USER=coreti-monitor
BACKUP_SSH_PORT=22
# Vazio usa a chave padrao do usuario que roda o agendador (root, via cron).
BACKUP_SSH_IDENTITY_FILE=
BACKUP_SSH_CONNECT_TIMEOUT=10
BACKUP_SSH_TIMEOUT=30
# Fracao da media historica usada como tamanho minimo aceitavel.
BACKUP_SSH_FRACAO_TAMANHO_MINIMO=0.5
BACKUP_ACTIVE_CHECK_TIME=09:00

# Reverificacao de alvo com problema em aberto (minutos), para detectar recuperacao.
BACKUP_REVERIFICACAO_PROBLEMA_MINUTOS=55

# Wrapper de auditoria instalado no servidor auditado (scripts/coreti-backup-audit).
# Vazio: o CoreTI monta o comando localmente (stat direto).
BACKUP_SSH_WRAPPER=

# Expurgo de contas do Active Directory.
# O servidor do AD envia a previa, uma pessoa aprova no CoreTI, e o servidor
# do AD volta para buscar o que foi aprovado. O CoreTI nunca recebe credencial
# de AD: guarda a decisao, nao o privilegio de apagar.
# Gere com: php artisan tinker --execute="echo bin2hex(random_bytes(32));"
AD_PURGE_TOKEN=
# Opcional: restringe a origem. IPs ou faixas CIDR separados por virgula.
AD_PURGE_ALLOWED_IPS=
# Dias de desativacao exigidos para a conta entrar na previa.
AD_PURGE_DIAS=30
# Validade da aprovacao. Depois disso o lote expira e nada e excluido.
AD_PURGE_VALIDADE_DIAS=15
# Teto de exclusoes por chamada, para nao sobrecarregar a replicacao entre DCs.
AD_PURGE_MAX_POR_EXECUCAO=200
# Destinatarios do aviso: NAO ficam aqui. Sao mantidos em
# Configuracoes > Notificacoes, evento "Expurgo do Active Directory".

# Base do COCARI Gestao TI, usada apenas pela importacao (somente leitura).
# A conexao 'gestaoti' recusa em codigo qualquer comando que nao seja SELECT.
GESTAOTI_DB_HOST=127.0.0.1
GESTAOTI_DB_PORT=3306
GESTAOTI_DB_DATABASE=cocari_gestao_ti
GESTAOTI_DB_USERNAME=
GESTAOTI_DB_PASSWORD=
GESTAOTI_STORAGE_PATH=/var/www/html/cocari_gestaoTI/storage/app/public

# EKM Insight API (portal HP Smart Device Services / Simpress).
# A chave e o segredo NAO sao o login do portal: sao um par gerado em
# System Administration > Insight API > API Users > Add new API user.
# Escopo limitado a COCARI e papel DATA_READER bastam para leitura.
INSIGHT_BASE_URL=https://hp-sds-latam2.insightportal.net/PortalAPI
INSIGHT_API_KEY=
INSIGHT_API_SECRET=
INSIGHT_CUSTOMER_IDS=
